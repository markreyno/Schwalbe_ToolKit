{
  "name": "schwalbe-toolkit",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "A desktop home for everyday Schwalbe tools",
  "author": "Schwalbe",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "test": "python -m unittest discover -s python/tests -v",
    "test:e2e": "npm run build && playwright test",
    "package": "npm run build && node scripts/package.mjs",
    "package:dir": "npm run build && node scripts/package.mjs --dir"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.170.33",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "44.2.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.3"
  },
  "build": {
    "appId": "com.schwalbe.toolkit",
    "productName": "Schwalbe ToolKit",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/python/toolkit-backend",
        "to": "python"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/schwalbe.ico",
      "signExecutable": false
    },
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "Schwalbe-ToolKit-Setup-${version}.${ext}",
      "createDesktopShortcut": true,
      "shortcutName": "Schwalbe ToolKit",
      "oneClick": false
    },
    "publish": [
      {
        "repo": "Schwalbe_ToolKit",
        "provider": "github",
        "owner": "markreyno",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/markreyno/Schwalbe_ToolKit.git"
  }
}
